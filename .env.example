# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed front-end origins (no wildcard allowed with credentials).
CLIENT_ORIGIN=http://localhost:5500,https://your-storefront-domain.com

# Database (PostgreSQL example — adjust for MySQL if preferred)
DATABASE_URL="postgresql://username:password@localhost:5432/demand_footwear?schema=public"

# Auth — the session cookie below is used for BOTH customers and admin/staff;
# role (CUSTOMER/ADMIN/STAFF) is checked per-route via requireRole().
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_SESSION_COOKIE_NAME=df_session

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Seed script (backend/prisma/seed.js) — creates one initial admin account.
# Set a strong password here, then run `npm run prisma:seed` once.
ADMIN_SEED_EMAIL=owner@demandfootwear.example
ADMIN_SEED_NAME=Store Owner
ADMIN_SEED_PASSWORD=change-this-before-seeding

# Image storage (example: Cloudinary / S3-compatible)
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment gateway / Mobile Financial Services (MFS)
# Bangladeshi checkouts typically route bKash, Nagad, Rocket and card
# payments through a licensed payment aggregator (e.g. SSLCommerz,
# ShurjoPay, AamarPay) rather than calling each MFS provider directly.
# If integrating directly with an MFS provider's merchant API instead,
# store its credentials the same way — never in front-end code.
PAYMENT_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# Direct MFS merchant credentials (only needed if NOT using an aggregator)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
ROCKET_MERCHANT_ID=
